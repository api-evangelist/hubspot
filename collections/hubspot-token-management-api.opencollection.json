{
  "opencollection": "1.0.0",
  "info": {
    "name": "HubSpot Analytics Events Access Tokens Token Management API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Token Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Hubspot Create or Refresh an Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.hubapi.com/oauth/v1/token",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Exchanges an authorization code for an access token or refreshes an existing access token\nusing a refresh token. This endpoint supports multiple grant types including authorization_code\nand refresh_token flows.\n"
        }
      ]
    }
  ],
  "bundled": true
