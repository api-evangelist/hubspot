              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inputs\": [\n    {\n      \"callbackId\": \"<string>\",\n      \"outputFields\": {\n        \"key_0\": \"<string>\"\n      }\n    },\n    {\n      \"callbackId\": \"<string>\",\n      \"outputFields\": {\n        \"key_0\": \"<string>\",\n        \"key_1\": \"<string>\",\n        \"key_2\": \"<string>\"\n      }\n    }\n  ]\n}",
