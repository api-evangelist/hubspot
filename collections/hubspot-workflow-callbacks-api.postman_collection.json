          "name": "Hubspot Complete Multiple Callbacks",
          "request": {
            "name": "Hubspot Complete Multiple Callbacks",
            "description": {
              "content": "Completes multiple callbacks for asynchronous workflow actions in a single request. \nThis is useful when your action processes multiple items and needs to return results \nfor each callback simultaneously.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "automation",
                "v4",
                "actions",
                "callbacks",
