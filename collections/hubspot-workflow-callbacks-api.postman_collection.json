        {
          "id": "2b48e72e-2472-4064-8471-99d899542e07",
          "name": "Hubspot Complete a Single Callback",
          "request": {
            "name": "Hubspot Complete a Single Callback",
            "description": {
              "content": "Completes a single callback for an asynchronous workflow action, providing the output \nvalues to continue the workflow execution. Use this endpoint when your action has \nfinished processing and needs to return results to HubSpot.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "automation",
                "v4",
                "actions",
                "callbacks",
                ":callbackId",
                "complete"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "callbackId",
                  "description": "(Required) The unique identifier of the callback to complete"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outputFields\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
