          "request": {
            "name": "Hubspot Schedule a Blog Post",
            "description": {
              "content": "Schedule a blog post for publication at a specific date and time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cms",
                "v3",
                "blogs",
                "posts",
                "schedule"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
