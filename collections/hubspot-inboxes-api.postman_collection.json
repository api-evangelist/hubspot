          "name": "Hubspot List All Inboxes",
          "request": {
            "name": "Hubspot List All Inboxes",
            "description": {
              "content": "Retrieve a paginated list of all conversation inboxes in your HubSpot account.\nUse query parameters to filter, sort, and paginate results.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "conversations",
                "v3",
                "conversations",
                "inboxes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of results per page (1-100)"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Pagination cursor for retrieving the next page of results"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Property name to sort results by"
                },
                {
                  "disabled": false,
                  "key": "archived",
                  "value": "false",
                  "description": "Set to true to include archived inboxes in results"
                }
              ],
              "variable": []
            },
