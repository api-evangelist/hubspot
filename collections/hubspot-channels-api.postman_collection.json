          "name": "Hubspot List Channels",
          "request": {
            "name": "Hubspot List Channels",
            "description": {
              "content": "Retrieve a list of available conversation channels configured in your account.\nChannels represent different communication methods like email, chat, or social media.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "conversations",
                "v3",
                "conversations",
                "channels"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of channels per page"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Pagination cursor for the next page"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "analytics.read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.hubapi.com/oauth/v1/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://app.hubspot.com/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
