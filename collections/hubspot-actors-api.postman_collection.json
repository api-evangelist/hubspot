          "id": "d8eda6be-876d-4d46-8aaa-f065a18bb681",
          "name": "Hubspot List Actors",
          "request": {
            "name": "Hubspot List Actors",
            "description": {
              "content": "Retrieve a list of conversation actors (participants) in your account.\nActors can be visitors, agents, or bots who participate in conversations.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "conversations",
                "v3",
                "conversations",
                "actors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of actors per page"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Pagination cursor for the next page"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "analytics.read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.hubapi.com/oauth/v1/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://app.hubspot.com/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
          "response": [
