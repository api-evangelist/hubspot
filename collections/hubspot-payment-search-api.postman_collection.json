                  "raw": "{\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"hs_payment_status\",\n          \"operator\": \"EQ\",\n          \"value\": \"completed\"\n        },\n        {\n          \"propertyName\": \"hs_amount\",\n          \"operator\": \"GTE\",\n          \"value\": \"100\"\n        }\n      ]\n    }\n  ],\n  \"sorts\": [\n    {\n      \"propertyName\": \"hs_amount\",\n      \"direction\": \"DESCENDING\"\n    }\n  ],\n  \"properties\": [\n    \"hs_payment_status\",\n    \"hs_amount\",\n    \"hs_currency\"\n  ],\n  \"limit\": 20\n}",
