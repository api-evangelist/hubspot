        {
          "id": "a1fccd99-8e9d-45a1-a7ff-1932987908ba",
          "name": "Hubspot Batch Create or Update Portal Flag States",
          "request": {
            "name": "Hubspot Batch Create or Update Portal Flag States",
            "description": {
              "content": "Sets flag states for multiple portals (accounts) in a single request.\nEfficiently enables or disables features for multiple accounts at once.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "feature-flags",
                "v3",
                ":appId",
                "flags",
                ":flagName",
                "portals",
                "batch",
                "upsert"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "appId",
                  "description": "(Required) The unique identifier for the HubSpot application"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "flagName",
                  "description": "(Required) The name of the feature flag"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inputs\": [\n    {\n      \"portalId\": \"<long>\",\n      \"flagState\": \"<string>\"\n    },\n    {\n      \"portalId\": \"<long>\",\n      \"flagState\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
