            "description": {
              "content": "Retrieves metadata for a specific OAuth access token, including associated scopes,\nexpiration time, and the user and hub information linked to the token.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "v1",
                "access-tokens",
                ":token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) The OAuth access token to retrieve metadata for"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
