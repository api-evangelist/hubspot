              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "environment",
                  "description": "(Required) The target environment for the operation (draft or published)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "path",
                  "description": "(Required) The file system path to the file or folder"
